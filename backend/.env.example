# Django
SECRET_KEY=your-secret-key-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com

# Database (optional for local dev; development uses SQLite by default)
# Set DATABASE_URL only when using PostgreSQL (e.g. production or local Postgres)
# DATABASE_URL=postgres://user:password@localhost:5432/qa_tracker_db

# CORS - Frontend origin (Vercel URL in production)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# JWT
SIMPLE_JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
SIMPLE_JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
