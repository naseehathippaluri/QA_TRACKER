# Django
SECRET_KEY=your-secret-key-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com

# Database - PostgreSQL (dev and production)
# Option 1: DATABASE_URL (single connection string)
# DATABASE_URL=postgres://user:password@localhost:5432/qa_tracker_dev
# Option 2: Individual vars (default dev db: qa_tracker_dev)
# PGDATABASE=qa_tracker_dev
# PGUSER=postgres
# PGPASSWORD=your_password
# PGHOST=localhost
# PGPORT=5432

# CORS - Frontend origin (Vercel URL in production)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# JWT
SIMPLE_JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
SIMPLE_JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
